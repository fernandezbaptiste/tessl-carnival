{
  "name": "bapfernandez/tessl-carnival",
  "dependencies": {},
  "actions": {
    "follow-ticket-changes": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-haiku-4-5",
      "skill": "tessl/factory#follow-ticket-changes",
      "environment": "factory-bapfernandez-tessl-carnival-follow-ticket-changes"
    },
    "implement": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/factory#implement-github-issue",
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      },
      "environment": "factory-bapfernandez-tessl-carnival-implement"
    },
    "learn-from-agent-runs": {
      "tags": [
        "Learn from past work"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/learn-from-past-work#learn-from-agent-runs",
      "effort": "medium",
      "environment": "improve-bapfernandez-tessl-carnival-04d85544-agent-retro",
      "instructions": "Review recent implementation runs for fernandezbaptiste/tessl-carnival together with their pull-request reviews. Focus on recurring problems supported by evidence from at least two different pull requests or implementation runs. Recommend the smallest useful improvement to agent instructions, repository skills, or validation checks. Record at most three actionable findings with links to supporting runs and pull requests, and a clear expected improvement. Deduplicate against existing findings. Do not infer a recurring pattern from several review rounds on just one pull request. Prefer no findings to weak evidence. Write project findings only; do not create or label tickets, post comments, change settings, edit files, push code, or open pull requests.",
      "inputs": {
        "orgId": "cbb0390d-1be3-4dfa-9541-d10dd634b3c7",
        "projectId": "01a1b162-3c4b-7729-8ab6-474b04d85544",
        "windowDays": "7"
      }
    },
    "shepherd": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/factory#shepherd",
      "concurrency": {
        "keys": [
          {
            "key": "github:pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ],
        "debounce": "90s"
      },
      "environment": "factory-bapfernandez-tessl-carnival-shepherd"
    },
    "turn-findings-into-tickets": {
      "tags": [
        "Learn from past work"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/learn-from-past-work#findings-triage",
      "effort": "medium",
      "concurrency": {
        "keys": [
          {
            "key": "turn-findings-into-tickets",
            "limit": 1
          }
        ]
      },
      "environment": "factory-bapfernandez-tessl-carnival-implement",
      "instructions": "Triage findings only for fernandezbaptiste/tessl-carnival. Check every finding against the current default branch and existing linked work. Create at most one new GitHub issue total per run. For a verified, worthwhile fix implementable inside this repository, write a complete issue with evidence links, scope, specific Done when criteria and validation instructions, link it to the finding, and apply the tessl label so the existing Ticket to PR factory starts automatically. Avoid duplicate issues and skip findings with existing open tickets or pull requests. If the finding requires changing account settings, granting access, editing an upstream published skill, or moving Tessl-managed loops into tessl.json, file a clearly marked human-action issue without the tessl label and explain the prerequisite. Do not ask the implementation factory to perform those setup actions. Keep repository house rules. Do not merge pull requests or make implementation changes yourself.",
      "inputs": {
        "orgId": "cbb0390d-1be3-4dfa-9541-d10dd634b3c7",
        "projectId": "01a1b162-3c4b-7729-8ab6-474b04d85544"
      }
    }
  },
  "triggers": {
    "issue-unlabelled": {
      "on": [
        "github:issues.unlabeled"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            83458751
          ]
        },
        "event.label.name": "tessl"
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "taken-back",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "issue-closed": {
      "on": [
        "github:issues.closed"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            83458751
          ]
        },
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "issue-ended",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "issue-replied": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "false",
        "event.sender.id": {
          "in": [
            83458751
          ]
        },
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "replied",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "pr-closed": {
      "on": [
        "github:pull_request.closed"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            83458751
          ]
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "pr-closed",
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}",
          "GITHUB_ISSUE_LABEL": "tessl"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "issue-labelled": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl"
      },
      "action": {
        "use": "implement",
        "inputs": {
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            83458751,
            "{{ github.tesslReviewerApp.userId }}"
          ]
        },
        "event.pull_request.state": "open",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1448345685,
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "pr-review-comment": {
      "on": [
        "github:pull_request_review_comment.created"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            83458751
          ]
        },
        "event.pull_request.state": "open",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1448345685,
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "pr-comment": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "true",
        "event.sender.id": {
          "in": [
            83458751
          ]
        },
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.issue.number }}"
        }
      }
    }
  },
  "schedules": {
    "learn-from-agent-runs": {
      "cron": "0 9 * * 1",
      "timezone": "UTC",
      "action": "learn-from-agent-runs"
    },
    "turn-findings-into-tickets": {
      "cron": "0 9 * * 2",
      "timezone": "UTC",
      "action": "turn-findings-into-tickets"
    }
  }
}
